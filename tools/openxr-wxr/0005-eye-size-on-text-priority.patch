+// eye_size=WxH: both even and within 64..4096, else rejected with the size left as it was
+static bool parseEyeSize(const std::string str, int& width, int& height) {
+    size_t pos = str.find('=');
+    if (pos == std::string::npos) return false;
+    const char* value = str.c_str() + pos + 1;
+    auto readDimension = [&value](int& dimension) {
+        while (std::isspace(static_cast<unsigned char>(*value))) ++value;
+        if (*value == '+') ++value;
+        if (*value < '0' || *value > '9') return false;
+        while (*value >= '0' && *value <= '9') {
+            // The previous value was at most 4096, so this step fits in int.
+            dimension = dimension * 10 + (*value++ - '0');
+            if (dimension > 4096) return false;
+        }
+        return dimension >= 64 && dimension % 2 == 0;
+    };
+    int w = 0, h = 0;
+    if (!readDimension(w) || *value++ != 'x' || !readDimension(h)) return false;
+    while (std::isspace(static_cast<unsigned char>(*value))) ++value;
+    if (*value != '\0') return false;
+    width = w;
+    height = h;
+    return true;
+}
+
+// Direct frames skip the preview window, so they can be the headset's own size; otherwise eye_size,
+// else half the screen (all of it in mono)
+static void recommendedEyeSize(bool direct, int& width, int& height) {
+    if (direct) { width = DirectEyeWidth; height = DirectEyeHeight; }
+    else if (ConfEyeWidth > 0) { width = ConfEyeWidth; height = ConfEyeHeight; }
+    else { width = monoRendering ? ViewportWidth : ViewportWidth / 2; height = ViewportHeight; }
+}
+
+// With eye_size the preview stays the screen and the blit scales each eye into its half; without
+// it the preview is both submitted eyes side by side, as before
+static void vulkanPreviewSize(uint32_t eyeWidth, uint32_t eyeHeight, uint32_t& width, uint32_t& height) {
+    if (ConfEyeWidth > 0) { width = (uint32_t)ViewportWidth; height = (uint32_t)ViewportHeight; }
+    else { width = eyeWidth * 2; height = eyeHeight; }
 }
 
