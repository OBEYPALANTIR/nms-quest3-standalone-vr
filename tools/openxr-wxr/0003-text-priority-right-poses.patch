+WinXrApiUDP::RightPoseRole WinXrApiUDP::ResolveRightPoseRole(int hand, std::string_view binding)
+{
+	if (hand != 2) return RightPoseRole::Other;
+	if (binding == "/user/hand/right/input/aim/pose") return RightPoseRole::Aim;
+	if (binding == "/user/hand/right/input/grip/pose") return RightPoseRole::Grip;
+	return RightPoseRole::Other;
+}
+
+WinXrApiUDP::PoseSource WinXrApiUDP::GetPreferredRightPose(int space, int baseSpace, WxrHostPose& out, bool allowBinary)
+{
+	std::lock_guard<std::mutex> lock(mtx);
+	if (!actionSpaces.count(space)) return PoseSource::Missing;
+
+	auto read = [&](const WxrHostState& sample) {
+		for (const WxrHostPose& pose : sample.poses) {
+			if (pose.space != space || pose.baseSpace != baseSpace || !pose.complete) continue;
+			if (!std::all_of(std::begin(pose.pose), std::end(pose.pose),
+			                 [](float value) { return std::isfinite(value); })) continue;
+			if (!std::all_of(std::begin(pose.velocity), std::end(pose.velocity),
+			                 [](float value) { return std::isfinite(value); })) continue;
+			const float flags = pose.velocity[0];
+			if (flags < 0 || flags > 3 || flags != std::trunc(flags)) continue;
+
+			// Four-decimal CLIENT0 components can perturb unit length by at
+			// most 0.0001. Accept a small margin, then normalize the pose.
+			constexpr double tolerance = 0.001;
+			double normSquared = 0;
+			for (int i = 3; i < 7; ++i) normSquared += double(pose.pose[i]) * pose.pose[i];
+			if (normSquared < (1 - tolerance) * (1 - tolerance) ||
+			    normSquared > (1 + tolerance) * (1 + tolerance)) continue;
+			out = pose;
+			const double norm = std::sqrt(normSquared);
+			for (int i = 3; i < 7; ++i) out.pose[i] /= norm;
+			return true;
+		}
+		return false;
+	};
+	// Read-time freshness prevents a diagnostic sample sticking when the sender stops.
+	if (hasInject && injectState.client0 && GetTickCount64() - stats.lastTextMs < kTextFreshMs &&
+	    read(injectState)) return PoseSource::Text;
+	return allowBinary && read(hostState) ? PoseSource::Host : PoseSource::Missing;
+}
