+// Called with mtx held. Purge samples that refer to an earlier lifetime of the handle.
+void WinXrApiUDP::ForgetSpacePoses(int space)
+{
+	for (auto* poses : { &hostState.poses, &injectState.poses, &state.poses }) {
+		poses->erase(std::remove_if(poses->begin(), poses->end(), [space](const WxrHostPose& pose) {
+			return pose.space == space || pose.baseSpace == space;
+		}), poses->end());
+	}
+}
