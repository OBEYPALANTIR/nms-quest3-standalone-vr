+		if (std::fabs(injectState.floats[i]) > 0.01f)
+			injectHasControllerInput = true;
+		if (std::fabs(injectState.floats[i]) > std::fabs(state.floats[i]))
+			state.floats[i] = injectState.floats[i];
+	}
+	for (int i = 0; i < 19; i++) {
+		if (injectState.buttons[i]) {
+			injectHasControllerInput = true;
+			state.buttons[i] = true;
+		}
+	}
+
+	// Check whether injectState specifies a non-identity synthetic HMD pose (e.g. a synthetic yaw test)
+	bool injectHasCustomHead = false;
+	for (const WxrHostPose& q : injectState.poses) {
+		if (q.space != 0) continue;
+		if (std::fabs(q.pose[0]) > 1e-4f || std::fabs(q.pose[1]) > 1e-4f || std::fabs(q.pose[2]) > 1e-4f ||
+		    std::fabs(q.pose[3]) > 1e-4f || std::fabs(q.pose[4]) > 1e-4f || std::fabs(q.pose[5]) > 1e-4f ||
+		    std::fabs(q.pose[6] - 1.0f) > 1e-4f) {
+			injectHasCustomHead = true;
+			break;
+		}
+	}
+
+	// Check if host has at least one non-identity head space (to distinguish STAGE/LOCAL from VIEW space)
+	bool hostHasNonIdentityHead = false;
+	for (const WxrHostPose& p : hostState.poses) {
+		if (p.space != 0) continue;
+		if (std::fabs(p.pose[0]) > 1e-4f || std::fabs(p.pose[1]) > 1e-4f || std::fabs(p.pose[2]) > 1e-4f ||
+		    std::fabs(p.pose[3]) > 1e-4f || std::fabs(p.pose[4]) > 1e-4f || std::fabs(p.pose[5]) > 1e-4f ||
+		    std::fabs(p.pose[6] - 1.0f) > 1e-4f) {
+			hostHasNonIdentityHead = true;
+			break;
+		}
+	}
+
+	auto isValidPose = [](const WxrHostPose& p) {
+		return !(p.pose[3] == 0.0f && p.pose[4] == 0.0f && p.pose[5] == 0.0f && p.pose[6] == 0.0f);
+	};
+	auto isNonOriginPose = [&](const WxrHostPose& p) {
+		return isValidPose(p) && (std::fabs(p.pose[0]) > 1e-4f || std::fabs(p.pose[1]) > 1e-4f || std::fabs(p.pose[2]) > 1e-4f ||
+		                          std::fabs(p.pose[3]) > 1e-4f || std::fabs(p.pose[4]) > 1e-4f || std::fabs(p.pose[5]) > 1e-4f ||
+		                          std::fabs(p.pose[6] - 1.0f) > 1e-4f);
+	};
+
+	std::vector<WxrHostPose> merged;
+	merged.reserve(hostState.poses.size() + injectState.poses.size());
+
+	for (const WxrHostPose& p : hostState.poses) {
+		if (p.space == 0) {
+			if (injectHasCustomHead) {
+				// Leave VIEW space (identity in host when other head spaces are non-identity) untouched
+				bool isViewSpace = hostHasNonIdentityHead && !isNonOriginPose(p);
+				if (!isViewSpace) {
+					for (const WxrHostPose& q : injectState.poses) {
+						if (q.space == 0 && q.baseSpace == p.baseSpace && isValidPose(q)) {
+							WxrHostPose rot = p;
+							rot.pose[0] += q.pose[0];
+							rot.pose[1] += q.pose[1];
+							rot.pose[2] += q.pose[2];
+							// Quaternion multiply: p.q * q.q
+							float ax = p.pose[3], ay = p.pose[4], az = p.pose[5], aw = p.pose[6];
+							float bx = q.pose[3], by = q.pose[4], bz = q.pose[5], bw = q.pose[6];
+							rot.pose[3] = aw * bx + ax * bw + ay * bz - az * by;
+							rot.pose[4] = aw * by - ax * bz + ay * bw + az * bx;
+							rot.pose[5] = aw * bz + ax * by - ay * bx + az * bw;
+							rot.pose[6] = aw * bw - ax * bx - ay * by - az * bz;
+							merged.push_back(rot);
+							goto next_host_pose;
+						}
+					}
+				}
+			}
+			merged.push_back(p);
+			next_host_pose:;
+			continue;
+		}
+		// Controller pose: keep host pose when physical controller is tracked and injector has no active input
+		bool overridden = false;
+		if (actionSpaces.count(p.space) && (injectHasControllerInput || !isNonOriginPose(p))) {
+			for (const WxrHostPose& q : injectState.poses) {
+				if (q.space == p.space && q.baseSpace == p.baseSpace && isValidPose(q)) {
+					overridden = true;
+					break;
+				}
+			}
+		}
+		if (!overridden) merged.push_back(p);
+	}
+
+	// Add any injector poses not already in merged
+	for (const WxrHostPose& q : injectState.poses) {
+		if ((q.space != 0 && !actionSpaces.count(q.space)) || !isValidPose(q)) continue;
+		bool exists = false;
+		for (const WxrHostPose& m : merged) {
+			if (m.space == q.space && m.baseSpace == q.baseSpace) { exists = true; break; }
+		}
+		if (!exists) merged.push_back(q);
+	}
+	state.poses = std::move(merged);
