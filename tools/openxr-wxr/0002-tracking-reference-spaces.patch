+// Builds state from the host and injector packets per sourcePolicy. Called with mtx held.
+void WinXrApiUDP::Compose(unsigned long long nowMs)
+{
+	const bool merge = sourcePolicy.load() == 1;
+	const bool hostFresh = hasHost && (nowMs - stats.lastBinMs) < 1000;
+	const bool injectFresh = hasInject && (nowMs - stats.lastTextMs) < 500;
+
+	if (!hostFresh) {
+		// No host (or it stopped): fall back to whatever arrived, so the game never waits forever
+		state = hasInject ? injectState : hostState;
+		if (merge && hasInject) {
+			auto isReferencePair = [this](const WxrHostPose& pose) {
+				return pose.space != 0 && actionSpaces.count(pose.space) == 0;
+			};
+			auto& poses = state.poses;
+			poses.erase(std::remove_if(poses.begin(), poses.end(), isReferencePair), poses.end());
+			std::copy_if(hostState.poses.begin(), hostState.poses.end(),
+			             std::back_inserter(poses), isReferencePair);
+		}
+		return;
+	}
