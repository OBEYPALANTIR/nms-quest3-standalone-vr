+
+// OXRWXR-NMS: logs each action that crosses its pressed threshold, without verbose_logging.
+// Each line names the game's action when a controller input crosses its threshold.
+static void LogActionEdge(const char* kind, const XrActionStateGetInfo* info, float x, float y) {
+    static std::mutex edgeMutex;
+    static std::map<std::pair<XrAction, XrPath>, int> lastBucket;
+    static int edgeLogCount = 0;
+    float mag = (y == 0.0f) ? x : sqrtf(x * x + y * y);
+    int bucket = mag > 0.5f ? 1 : (mag < -0.5f ? -1 : 0);
+    std::lock_guard<std::mutex> lock(edgeMutex);
+    auto key = std::make_pair(info->action, info->subactionPath);
+    auto it = lastBucket.find(key);
+    if (it == lastBucket.end()) { lastBucket[key] = bucket; if (bucket == 0) return; }
+    else if (it->second == bucket) return;
+    else it->second = bucket;
+    if (edgeLogCount >= 2000) return;
+    edgeLogCount++;
+    auto nameIt = rt::g_actionNames.find(info->action);
+    Logf("[SimXR] ACTION_EDGE %s action=%s sub=%llu path=%s value=(%.2f,%.2f) state=%d sync=%llu",
+         kind, nameIt != rt::g_actionNames.end() ? nameIt->second.c_str() : "?",
+         (unsigned long long)info->subactionPath, GetActionName(info->action).c_str(), x, y, bucket,
+         (unsigned long long)g_syncCount);
 }
 
